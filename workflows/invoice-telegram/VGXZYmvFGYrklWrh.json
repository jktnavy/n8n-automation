      "parameters": {
        "text": "={{$json.message_text}}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"customer_name\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Nama customer atau perusahaan\"\n    },\n    \"pickup_location\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Lokasi penjemputan\"\n    },\n    \"destination\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Lokasi tujuan\"\n    },\n    \"departure_date\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Tanggal keberangkatan dalam format YYYY-MM-DD jika dapat ditentukan\"\n    },\n    \"vehicle\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Jenis kendaraan, misalnya Medium Bus, Big Bus, Hiace\"\n    },\n    \"quantity\": {\n      \"type\": [\"integer\", \"null\"],\n      \"description\": \"Jumlah unit kendaraan\"\n    },\n    \"unit_price\": {\n      \"type\": [\"number\", \"null\"],\n      \"description\": \"Harga per unit dalam Rupiah tanpa pemisah ribuan\"\n    },\n    \"included\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Komponen yang sudah termasuk harga\"\n    },\n    \"excluded\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Komponen yang tidak termasuk harga\"\n    },\n    \"payment_status\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Status pembayaran, misalnya lunas, DP, atau belum dibayar\"\n    },\n    \"notes\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Catatan tambahan\"\n    }\n  },\n  \"required\": [\n    \"customer_name\",\n    \"pickup_location\",\n    \"destination\",\n    \"departure_date\",\n    \"vehicle\",\n    \"quantity\",\n    \"unit_price\",\n    \"included\",\n    \"excluded\",\n    \"payment_status\",\n    \"notes\"\n  ],\n  \"additionalProperties\": false\n}",
        "options": {}
