      "parameters": {
        "text": "={{$json.message_text}}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"customer_name\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Nama customer atau perusahaan\"\n    },\n    \"pickup_location\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Lokasi penjemputan\"\n    },\n    \"destination\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Lokasi tujuan\"\n    },\n    \"departure_date\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Tanggal keberangkatan dalam format YYYY-MM-DD jika dapat ditentukan\"\n    },\n\t\"items\": {\n\t  \"type\": \"array\",\n\t  \"description\": \"Daftar kendaraan yang disewa\",\n\t  \"items\": {\n\t\t\"type\": \"object\",\n\t\t\"properties\": {\n\t\t  \"vehicle\": {\n\t\t\t\"type\": \"string\",\n\t\t\t\"description\": \"Jenis kendaraan\"\n\t\t  },\n\t\t  \"quantity\": {\n\t\t\t\"type\": \"integer\",\n\t\t\t\"description\": \"Jumlah unit kendaraan\"\n\t\t  },\n\t\t  \"unit_price\": {\n\t\t\t\"type\": \"number\",\n\t\t\t\"description\": \"Harga per unit tanpa format Rupiah\"\n\t\t  },\n\t\t\t\"price_basis\": {\n\t\t\t  \"type\": \"string\",\n\t\t\t  \"enum\": [\"per_trip\", \"per_day\"],\n\t\t\t  \"description\": \"Gunakan per_day jika harga berlaku per hari atau perjalanan berlangsung beberapa hari dan harga disebut sebagai harga harian. Gunakan per_trip hanya jika harga adalah harga paket sekali perjalanan tanpa perhitungan berdasarkan jumlah hari.\"\n\t\t\t}\n\t\t},\n\t\t\"required\": [\n\t\t  \"vehicle\",\n\t\t  \"quantity\",\n\t\t  \"unit_price\",\n\t\t  \"price_basis\"\n\t\t]\n\t  }\n\t},\n    \"included\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Komponen yang sudah termasuk harga\"\n    },\n    \"excluded\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Komponen yang tidak termasuk harga\"\n    },\n    \"payment_status\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Status pembayaran, misalnya lunas, DP, atau belum dibayar\"\n    },\n    \"notes\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Catatan tambahan\"\n    },\n\t\"return_date\": {\n\t  \"type\": [\"string\", \"null\"],\n\t  \"description\": \"Tanggal selesai atau tanggal pulang perjalanan dalam format YYYY-MM-DD jika tersedia\"\n\t}\n  },\n  \"required\": [\n    \"customer_name\",\n    \"pickup_location\",\n    \"destination\",\n    \"departure_date\",\n\t\"items\",\n    \"included\",\n    \"excluded\",\n    \"payment_status\",\n    \"notes\",\n\t\"return_date\"\n  ],\n  \"additionalProperties\": false\n}",
        "options": {
          "systemPromptTemplate": "=ATURAN HARGA:\n- Jika pengguna menulis \"per hari\", \"/hari\", \"per unit per hari\", atau harga berlaku untuk setiap hari perjalanan, set price_basis = \"per_day\".\n- Jika pengguna menyebut harga paket untuk seluruh perjalanan tanpa perhitungan per hari, set price_basis = \"per_trip\".\n- Jangan mengubah harga menjadi total. unit_price harus tetap harga satu unit sesuai basis harga."
        }
      },
