    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const invoice = $('Merge Invoice Data').item.json;\nconst savedInvoice = $('Save Invoice').item.json;\nconst telegram = $('Edit Fields').item.json;\n\nconst payload = {\n  invoice_id: savedInvoice.id,\n  invoice_number: savedInvoice.invoice_number,\n\n  invoice_date: invoice.invoice_date,\n\n  customer_name: invoice.customer_name,\n\n  pickup_location: invoice.pickup_location,\n  destination: invoice.destination,\n  departure_date: invoice.departure_date,\n\n  vehicle: invoice.vehicle,\n  quantity: Number(invoice.quantity),\n  unit_price: Number(invoice.unit_price),\n\n  subtotal: Number(invoice.subtotal),\n  total: Number(invoice.total),\n\n  included: invoice.included || [],\n  excluded: invoice.excluded || [],\n\n  payment_status: invoice.payment_status,\n  notes: invoice.notes\n};\n\nreturn {\n  json: {\n    invoice_id: savedInvoice.id,\n    invoice_number: savedInvoice.invoice_number,\n    chat_id: telegram.chat_id,\n\n    payload_base64: Buffer\n      .from(JSON.stringify(payload), 'utf8')\n      .toString('base64')\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2144,
        80
      ],
      "id": "9e6d3241-e04d-439e-bde8-6f96c52f18e8",
