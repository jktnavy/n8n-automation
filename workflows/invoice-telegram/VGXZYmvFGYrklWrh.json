    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into public.invoices (\n    invoice_number,\n    invoice_sequence,\n    invoice_date,\n    customer_name,\n    pickup_location,\n    destination,\n    departure_date,\n    return_date,\n    subtotal,\n    total,\n    payment_status,\n    included,\n    excluded,\n    notes\n)\nvalues (\n    $1,\n    $2,\n    $3::date,\n    $4,\n    $5,\n    $6,\n    $7::date,\n    $8::date,\n    $9,\n    $10,\n    $11,\n    $12::jsonb,\n    $13::jsonb,\n    $14\n)\nreturning\n    id,\n    invoice_number,\n    created_at;",
        "options": {
          "queryReplacement": "={{\n[\n  $json.invoice_number,\n  $json.sequence_no,\n  $json.invoice_date,\n  $json.customer_name,\n  $json.pickup_location,\n  $json.destination,\n  $json.departure_date,\n  $json.return_date,\n  Number($json.subtotal),\n  Number($json.total),\n  $json.payment_status,\n  JSON.stringify($json.included),\n  JSON.stringify($json.excluded),\n  $json.notes\n]\n}}"
