    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const missing = [];\n\nif (!$json.customer_name) missing.push('Nama customer');\nif (!$json.pickup_location) missing.push('Lokasi jemput');\nif (!$json.destination) missing.push('Tujuan');\nif (!$json.departure_date) missing.push('Tanggal keberangkatan');\n\nif (!Array.isArray($json.items) || $json.items.length === 0) {\n  missing.push('Rincian kendaraan');\n} else {\n  $json.items.forEach((item, index) => {\n    const no = index + 1;\n\n    if (!item.vehicle) {\n      missing.push(`Jenis kendaraan item ${no}`);\n    }\n\n    if (!Number(item.quantity)) {\n      missing.push(`Jumlah unit item ${no}`);\n    }\n\n    if (!Number(item.unit_price)) {\n      missing.push(`Harga per unit item ${no}`);\n    }\n\n    if (!item.price_basis) {\n      missing.push(`Basis harga item ${no}`);\n    }\n  });\n}\n\nreturn {\n  json: {\n    missing,\n    message:\n      'Data invoice belum lengkap.\\n\\nYang masih kurang:\\n- ' +\n      missing.join('\\n- ') +\n      '\\n\\nSilakan kirim ulang data invoice yang lengkap.'\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
