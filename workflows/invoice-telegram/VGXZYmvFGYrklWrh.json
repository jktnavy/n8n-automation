      "id": "f7a2168e-6a19-4b7c-885a-4d373bbcceba",
      "name": "Validate Invoice ( IF )"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $json.output;\n\nfunction daysInclusive(start, end) {\n  if (!start || !end) return 1;\n\n  const startDate = new Date(start + 'T00:00:00Z');\n  const endDate = new Date(end + 'T00:00:00Z');\n\n  const diff = Math.round(\n    (endDate - startDate) / (1000 * 60 * 60 * 24)\n  );\n\n  return diff + 1;\n}\n\nconst durationDays = daysInclusive(\n  data.departure_date,\n  data.return_date\n);\n\nconst items = (data.items || []).map(item => {\n  const quantity = Number(item.quantity || 0);\n  const unitPrice = Number(item.unit_price || 0);\n\n  const billableDays =\n    item.price_basis === 'per_day'\n      ? durationDays\n      : 1;\n\n  const subtotal =\n    quantity *\n    unitPrice *\n    billableDays;\n\n  return {\n    vehicle: item.vehicle,\n    quantity,\n    unit_price: unitPrice,\n    price_basis: item.price_basis,\n    days: billableDays,\n    subtotal\n  };\n});\n\nconst total = items.reduce(\n  (sum, item) => sum + item.subtotal,\n  0\n);\n\nreturn {\n  json: {\n    customer_name: data.customer_name,\n    pickup_location: data.pickup_location,\n    destination: data.destination,\n\n    departure_date: data.departure_date,\n    return_date: data.return_date,\n    duration_days: durationDays,\n\n    items,\n\n    subtotal: total,\n    total,\n\n    included: data.included || [],\n    excluded: data.excluded || [],\n\n    payment_status: data.payment_status,\n    notes: data.notes\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        176
      ],
      "id": "da0ae316-777c-4f86-9c8b-1ac96d9c76d1",
      "name": "Calculate Invoice ( Code )"
    },
    {
      "parameters": {
        "jsCode": "const invoiceId = $('Save Invoice').item.json.id;\nconst invoice = $('Merge Invoice Data').item.json;\n\nreturn invoice.items.map(item => ({\n  json: {\n    invoice_id: invoiceId,\n    description: item.vehicle,\n    quantity: Number(item.quantity),\n    unit_price: Number(item.unit_price),\n    days: Number(item.days),\n    price_basis: item.price_basis,\n    subtotal: Number(item.subtotal)\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
